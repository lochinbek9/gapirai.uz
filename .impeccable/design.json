  "narrative": {
    "northStar": "The standard, played straight",
    "overview": "A clean, international AI-product look at the ElevenLabs/HeyGen/Rask/Linear bar: white or near-black ground, neutral greys, hairline borders, one accent from the logo blue, Geist. The hero is the working form; every number is real and dated.",
    "keyCharacteristics": [
      "Centered hero with the real form card",
      "One accent (logo blue) for state and links",
      "Ink primary buttons",
      "Hairline borders, 16px cards, 10px controls",
      "Geist 400/500/600, tabular numerals"
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Blue marks state and links, never decoration or large fills; primary CTAs are ink.",
        "section": "colors"
      },
      {
        "name": "The No-Shouting Rule",
        "body": "No uppercase labels, no eyebrows, no weight above 600.",
        "section": "typography"
      }
    ],
    "dos": [
      "Keep the working form in the first viewport",
      "Date every statistic",
      "Use *-ink variants for coloured text"
    ],
    "donts": [
      "Gradients, glow, glass, extra accent hues",
      "Condensed display type or themed metaphors",
