{
  "manifest_version": 3,
  "name": "GapirAI — YouTube oʻzbekcha",
  "short_name": "GapirAI",
  "version": "0.1.2",
  "description": "YouTube videolarini oʻzbekcha ovoz va subtitr bilan tomosha qiling.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "cookies",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://gapirai.uz/*",
    "https://api.gapirai.uz/*",
    "http://localhost:3000/*",
    "http://localhost:8000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
