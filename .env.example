# App Configuration
APP_NAME="AI Dubber"
DEBUG=True

# Abuse / capacity guardrails
# Max dubbing jobs one user can create per rolling 24h (separate from the
# plan's minute quota — a hard cap on top of it, so a runaway loop or an
# abusive account can't flood the queue). FAILED jobs don't count. 0 = off.
MAX_JOBS_PER_DAY="20"
# Local-disk auto-cleanup (backend/scripts/disk_cleanup.py, run from host
# cron). S3 copies expire via their own lifecycle; this stops the local
# outputs/ and uploads/ trees from growing without bound. 0 = don't touch
# that tree.
DISK_CLEANUP_OUTPUT_DAYS="3"
DISK_CLEANUP_UPLOAD_HOURS="48"

# Database (PostgreSQL)
DATABASE_URL="postgresql://dubber:dubber123@localhost:5432/dubber_db"
ASYNC_DATABASE_URL="postgresql+asyncpg://dubber:dubber123@localhost:5432/dubber_db"

# Redis / Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_TRANSCRIPTION_MODEL="whisper-1"

# Google Gemini (AI Studio) — used as the automatic fallback for translation
# AND transcription whenever OpenAI fails (e.g. credits exhausted). Free key:
# https://aistudio.google.com/apikey . Set TRANSLATE_PROVIDER=gemini to route
# translation straight to Gemini instead of trying OpenAI first.
# NOTE: as of 2026-09 Google 404s "gemini-2.5-flash" / "gemini-3.5-flash" for
# new accounts — use gemini-3.6-flash (the code default) or newer.
GEMINI_API_KEY=""
TRANSLATE_PROVIDER="openai"
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_VERTEX_TEXT_MODEL="gemini-3.6-flash"

# TTS provider selection (provider-independent — pipeline code doesn't change
# when you switch this). Options: elevenlabs | azure | edge | openai | gemini | uzbekvoice
TTS_PROVIDER="edge"
# Used only on TRANSIENT primary-provider failures (timeout/429/5xx) — never on
# permanent failures like a bad API key, see PermanentTTSError.
TTS_FALLBACK_PROVIDER="edge"

# UzbekVoiceAI TTS (https://uzbekvoice.ai/videos/api-docs/tts)
UZBEKVOICE_API_KEY=""
UZBEKVOICE_BASE_URL="https://uzbekvoice.ai/api/v1"
UZBEKVOICE_DEFAULT_MODEL="shoira"

# Azure TTS
AZURE_SPEECH_KEY="your-azure-key"
AZURE_SPEECH_REGION="eastus"
AZURE_VOICE_NAME="uz-UZ-SardorNeural"

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME="ai-dubber-videos"
AWS_REGION="us-east-1"

# Click Payment Integration
CLICK_MERCHANT_ID="56653"
CLICK_SERVICE_ID="108780"
# Click merchant secret — get from the Click merchant cabinet, set only in the
# real server .env (never commit). Used to verify prepare/complete webhook
# signatures; a leaked value lets anyone forge "payment approved" callbacks.
CLICK_SECRET_KEY=""
CLICK_MERCHANT_USER_ID="89102"

# Uzum Bank (Merchant webhook API). USERNAME/PASSWORD are chosen by us and
# handed to Uzum — they Basic-Auth their /check /create /confirm /reverse
# /status calls with them. UZUM_SERVICE_ID is the production id Uzum issued
# when the service was activated (2026-09-10). The payment form opens via
# https://uzumbank.uz/open-service?serviceId=<UZUM_SERVICE_ID>&account=<account>
UZUM_WEBHOOK_USERNAME=""
UZUM_WEBHOOK_PASSWORD=""
UZUM_SERVICE_ID="498658777"

# Paynet (UZPAYNET Universal Web-Service, JSON-RPC 2.0). USERNAME/PASSWORD/
# SERVICE_ID are chosen by us and handed to Paynet — no checkout URL; the
# user pays via the Paynet app or an ATM, entering the order_id we return
# (backend/api/paynet_routes.py).
PAYNET_USERNAME=""
PAYNET_PASSWORD=""
PAYNET_SERVICE_ID=""

# YouTube cookies.txt (Netscape format) — OPTIONAL, manually exported and
# refreshed by an operator with an authorized service account, never
# committed or baked into the Docker image (bind-mounted read-only, see
# docker-compose.yml). There is deliberately no automated login/refresh
# for this in the codebase (2026-08-26 ingestion audit) — automating a
# personal account's login is out of scope and against the spirit of an
# authorized-access-only ingestion service. A stale file (older than
# YOUTUBE_COOKIES_MAX_AGE_HOURS, default 96h) is treated as absent rather
# than trusted; see backend/services/downloader.py:cookie_status().
YOUTUBE_COOKIES_PATH="/app/cookies.txt"
YOUTUBE_COOKIES_MAX_AGE_HOURS="96"

# HTTP(S) proxy for yt-dlp — entirely OPTIONAL. Only needed on datacenter-hosted
# servers (AWS/GCP/etc), where YouTube flags the IP regardless of cookies/PO
# tokens. Leave both empty/false for a residential/local IP, or if PO tokens
# (see pot-provider in docker-compose.yml) already get through without a proxy —
# the downloader falls through to a direct connection cleanly either way.
# ENABLED lets you kill the proxy fast without clearing the URL, e.g. if the
# provider has an outage or billing lapse (a real 2026-08-22 production
# incident: Webshare ran out of balance, silently blocking every download).
YOUTUBE_PROXY_ENABLED="false"
YOUTUBE_PROXY_URL="http://user:pass@host:port"

# Second-tier (residential) proxy — only tried if the datacenter proxy above
# hits a bot-check error. Slower and pricier, so leave empty unless you've
# confirmed you need it; the code treats an empty value as "skip this tier".
YOUTUBE_RESIDENTIAL_PROXY_URL=""

# ---- Proxy pool: rotation + health tracking (backend/services/proxy_manager.py) ----
# 2026-09-04: N-proxy-per-tier pool that replaced the single-URL model above.
# Add/remove proxies here + `docker compose up -d backend worker` — no code
# change, no redeploy. The single-URL vars above still work as a 1-proxy
# fallback pool if the *_PROXIES vars below are left empty.
PROXY_ENABLED="false"
PROXY_DIRECT_FIRST="true"
# Comma-separated http://user:pass@host:port list. 2026-08-27 audit measured
# ZERO benefit over a direct connection for YouTube's bot-check — leave
# empty unless re-testing a different datacenter provider.
DATACENTER_PROXIES=""
# Comma-separated http://user:pass@host:port list. The one tier proven to
# help (2/4 first-attempt, 3/4 eventual in that same experiment).
RESIDENTIAL_PROXIES=""
# Hard cap on distinct endpoints tried per download, regardless of pool size.
PROXY_MAX_RETRIES="5"
PROXY_TIMEOUT="30"
# Seconds a failed proxy is skipped in rotation (a billing-exhausted proxy
# gets a much longer, separate cooldown — see proxy_manager.py).
PROXY_COOLDOWN_SECONDS="300"

# YouTube Data API v3 key (console.cloud.google.com) — used for metadata
# (title/duration/thumbnail) instead of scraping via yt-dlp, avoiding
# bot-check for that step entirely. Optional; falls back to yt-dlp if unset.
# Does NOT cover the actual video download (Data API has no video stream).
YOUTUBE_DATA_API_KEY=""

# Self-hosted local Telegram Bot API server (docker-compose.yml:
# telegram-bot-api) -- OPTIONAL. Raises the file-download limit from
# api.telegram.org's 20MB to 2GB, so the Telegram bot can accept a video
# file directly (not just a YouTube link). Leave all three empty to keep
# using api.telegram.org as-is -- the bot still works, video-file uploads
# just stay disabled with a clear message; the YouTube-link flow is
# unaffected either way. TELEGRAM_API_ID/TELEGRAM_API_HASH come from
# https://my.telegram.org (a personal Telegram account, manual one-time step
# -- there is no API to automate this signup).
TELEGRAM_API_ID=""
TELEGRAM_API_HASH=""
TELEGRAM_LOCAL_API_URL="http://telegram-bot-api:8081"

# Frontend URL (For payment redirects)
FRONTEND_URL="http://localhost:3000"

# JWT — safe to leave as the default below; override in production for real
# security hardening (rotating it invalidates all existing sessions).
SECRET_KEY="ai-dubber-secret-key-2024-uzbek-platform"

# Google Sign-In — only Client ID needed (frontend uses Google Identity
# Services, backend verifies the token by this ID; no Client Secret needed).
# Leave empty to hide the Google button entirely.
GOOGLE_CLIENT_ID=""

# Eskiz.uz SMS OTP (https://notify.eskiz.uz/api) — leave empty to disable
# phone login (requests will fail with a clean error, feature stays hidden-off).
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"
