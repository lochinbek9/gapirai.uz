# App Configuration
APP_NAME="AI Dubber"
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL="postgresql://dubber:dubber123@localhost:5432/dubber_db"
ASYNC_DATABASE_URL="postgresql+asyncpg://dubber:dubber123@localhost:5432/dubber_db"

# Redis / Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_TRANSCRIPTION_MODEL="whisper-1"

# Azure TTS
AZURE_SPEECH_KEY="your-azure-key"
AZURE_SPEECH_REGION="eastus"
AZURE_VOICE_NAME="uz-UZ-SardorNeural"

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME="ai-dubber-videos"
AWS_REGION="us-east-1"

# YouTube
YOUTUBE_EMAIL=""
YOUTUBE_PASSWORD=""

# Click Payment Integration
CLICK_MERCHANT_ID="your_merchant_id"
CLICK_SERVICE_ID="your_service_id"
CLICK_SECRET_KEY="your_secret_key"

# Frontend URL (For payment redirects)
FRONTEND_URL="http://localhost:3000"
