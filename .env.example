# App Configuration
APP_NAME="AI Dubber"
DEBUG=True

# Database (PostgreSQL)
DATABASE_URL="postgresql://dubber:dubber123@localhost:5432/dubber_db"
ASYNC_DATABASE_URL="postgresql+asyncpg://dubber:dubber123@localhost:5432/dubber_db"

# Redis / Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# OpenAI
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"
OPENAI_TRANSCRIPTION_MODEL="whisper-1"

# TTS provider selection (provider-independent — pipeline code doesn't change
# when you switch this). Options: elevenlabs | azure | edge | openai | gemini | uzbekvoice
TTS_PROVIDER="edge"
# Used only on TRANSIENT primary-provider failures (timeout/429/5xx) — never on
# permanent failures like a bad API key, see PermanentTTSError.
TTS_FALLBACK_PROVIDER="edge"

# UzbekVoiceAI TTS (https://uzbekvoice.ai/videos/api-docs/tts)
UZBEKVOICE_API_KEY=""
UZBEKVOICE_BASE_URL="https://uzbekvoice.ai/api/v1"
UZBEKVOICE_DEFAULT_MODEL="shoira"

# Azure TTS
AZURE_SPEECH_KEY="your-azure-key"
AZURE_SPEECH_REGION="eastus"
AZURE_VOICE_NAME="uz-UZ-SardorNeural"

# AWS S3 (Optional) — leave all four empty to disable S3 (local-disk fallback).
# Set all four in production. Empty bucket/region => storage._get_s3_client()
# returns (None, None); no default bucket is assumed.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_BUCKET_NAME=""
AWS_REGION=""

# Click Payment Integration
CLICK_MERCHANT_ID="56653"
CLICK_SERVICE_ID="108780"
# SECRET from the Click merchant cabinet. MUST be set in production — an empty
# value makes the /prepare and /complete webhooks fail-open (signature check
# against an empty key), letting anyone mark a payment APPROVED.
CLICK_SECRET_KEY=""
CLICK_MERCHANT_USER_ID="89102"

# YouTube Cookie Auto-Refresh
YOUTUBE_EMAIL="your-youtube-email@gmail.com"
YOUTUBE_PASSWORD="your-youtube-password"

# HTTP(S) proxy for yt-dlp — needed on datacenter-hosted servers (AWS/GCP/etc),
# YouTube flags those IPs regardless of cookies/PO tokens. Leave empty for a
# residential/local IP where it's not needed. ENABLED lets you kill the proxy
# fast without clearing the URL, if the provider has an outage.
YOUTUBE_PROXY_ENABLED="true"
YOUTUBE_PROXY_URL="http://user:pass@host:port"

# Frontend URL (For payment redirects)
FRONTEND_URL="http://localhost:3000"

# JWT signing key. The variable name is SECRET_KEY (NOT "JWT_SECRET_KEY" —
# ignore any doc that says otherwise). MUST be a real random value in
# production: an empty or short one lets anyone forge a token for any user,
# admin included. In production (DEBUG=False) the app refuses to start
# without it. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=""

# Google Sign-In — only Client ID needed (frontend uses Google Identity
# Services, backend verifies the token by this ID; no Client Secret needed).
# Leave empty to hide the Google button entirely.
GOOGLE_CLIENT_ID=""

# Eskiz.uz SMS OTP (https://notify.eskiz.uz/api) — leave empty to disable
# phone login (requests will fail with a clean error, feature stays hidden-off).
ESKIZ_EMAIL=""
ESKIZ_PASSWORD=""
ESKIZ_FROM="4546"

# ─────────────────────────────────────────────────────────────────────────
# Chunked pipeline / GPU (from the ai-dubbet integration). All optional —
# defaults in backend/config.py are production-safe.
# ─────────────────────────────────────────────────────────────────────────
# Chunked pipeline is OPT-IN. Leave false until it has been load-tested;
# false = the stable sequential pipeline with full job_claim/checkpoint.
ENABLE_CHUNKED_PIPELINE="false"
CHUNK_DURATION_SEC="180"
MAX_PARALLEL_CHUNKS="2"
CHUNK_OVERLAP_SEC="1.5"
# NVENC auto-detects an NVIDIA GPU and falls back to CPU (libx264) when absent.
ENABLE_NVENC="true"
# faster-whisper local model: tiny | small | medium | large-v3
WHISPER_MODEL="small"
# Modal serverless GPU/CPU. false = everything runs locally.
MODAL_ENABLED="false"
# MODAL_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────
# Extra AI providers (all optional — used only for fallback chains).
# ─────────────────────────────────────────────────────────────────────────
# Gemini free tier ~20 req/day/key — add spares for auto-rotation on 429.
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
# Extra LLM translators (fallback after OpenAI/Gemini)
CLAUDE_API_KEY=""
MISTRAL_API_KEY=""
DEEPSEEK_API_KEY=""
GROQ_API_KEY=""
COHERE_API_KEY=""
# Extra STT (fallback after Whisper/Gemini)
ASSEMBLYAI_API_KEY=""
DEEPGRAM_API_KEY=""
GOOGLE_STT_CREDENTIALS=""
# Extra TTS (fallback). NOTE: Polly has no Uzbek voice — "Filiz" is Turkish.
AWS_POLLY_ACCESS_KEY=""
AWS_POLLY_SECRET_KEY=""
GOOGLE_CLOUD_TTS_CREDENTIALS=""
PLAYHT_API_KEY=""
PLAYHT_USER_ID=""

# Payme (Paycom) — leave blank/sandbox until the kassa is activated for prod.
PAYME_MERCHANT_ID=""
PAYME_KEY=""
PAYME_TEST_KEY=""
PAYME_SANDBOX_MODE="true"
