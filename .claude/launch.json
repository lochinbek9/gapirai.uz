{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 3000
    },
    {
      "name": "frontend-3001",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3001"
      ],
      "cwd": "frontend",
      "port": 3001
    },
    {
      "name": "Backend + Worker + DB (Docker Compose)",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "up"
      ],
      "cwd": ".",
      "port": 8000
    },
    {
      "name": "Flower Monitor (Celery UI)",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "up",
        "flower"
      ],
      "cwd": ".",
      "port": 5555
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web"
      ],
      "cwd": "mobile",
      "port": 8081
    }
  ]
}